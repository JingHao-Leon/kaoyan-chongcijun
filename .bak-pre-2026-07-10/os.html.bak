  <div class="zhenti-year" style="margin-bottom:32px;">
    <h3 style="color:#2c3e50;border-left:4px solid #3498db;padding-left:12px;">2018年真题（共8页）</h3>
    <div style="text-align:center;margin:16px 0;">
      <img src="images/zhenti_pages/408_2018_p1.png" style="max-width:100%;max-height:500px;border-radius:8px;border:1px solid #e3e2e0;" alt="2018年真题 408_2018_p1.png">
    </div>
    <div style="text-align:center;margin:16px 0;">
      <img src="images/zhenti_pages/408_2018_p2.png" style="max-width:100%;max-height:500px;border-radius:8px;border:1px solid #e3e2e0;" alt="2018年真题 408_2018_p2.png">
    </div>
    <div style="text-align:center;margin:16px 0;">
      <img src="images/zhenti_pages/408_2018_p3.png" style="max-width:100%;max-height:500px;border-radius:8px;border:1px solid #e3e2e0;" alt="2018年真题 408_2018_p3.png">
